# Set these privately in Hostinger's environment settings, never in GitHub.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@soeicam.com
SMTP_PASSWORD=
# Optional separate random secret for form challenge signing.
ENQUIRY_TOKEN_SECRET=
# Enable only after Hostinger confirms it replaces x-forwarded-for reliably.
TRUST_PROXY_IP=false
# Optional; leave empty until the actual properties are available.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Find our Products: server-only connection to the same Supabase project as the ERP.
# Never prefix either ERP variable with NEXT_PUBLIC_. Never commit the real key.
ERP_SUPABASE_URL=
ERP_SUPABASE_SECRET_KEY=
# Browser-restricted Maps JavaScript API key and JavaScript map ID.
# Production website restrictions in Google Cloud:
# https://soeicam.com/* and https://www.soeicam.com/*
# These comments do not change the Google Cloud key's settings.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
