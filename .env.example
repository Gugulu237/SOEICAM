# Set these privately in Hostinger's environment settings, never in GitHub.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@soeicam.com
SMTP_PASSWORD=
# Optional separate random secret for form challenge signing.
ENQUIRY_TOKEN_SECRET=
# Enable only after Hostinger confirms it replaces x-forwarded-for reliably.
TRUST_PROXY_IP=false
# Optional; leave empty until the actual properties are available.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
